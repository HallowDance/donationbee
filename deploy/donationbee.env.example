# /etc/donationbee/env  (root:donationbee, mode 0640). Read by the systemd units in ./systemd.
VPP_DATABASE_URL=postgresql+psycopg://donationbee@/vpp_beta?host=/var/run/postgresql
VPP_ORIGIN=bee.theorycorner.com/log
VPP_PUBLIC_BASE_URL=https://bee.theorycorner.com
VPP_RP_ID=bee.theorycorner.com
VPP_SIGNING_KEY_PATH=/var/lib/donationbee/online.key
VPP_SECRET_KEY=<64 hex chars: python3 -c "import secrets; print(secrets.token_hex(32))">
VPP_STRIPE_SECRET_KEY=<sk_test_... from the Stripe sandbox>
VPP_STRIPE_WEBHOOK_SECRET=<whsec_... of the webhook endpoint>
VPP_WITNESSES='[{"vkey": "<contents of /var/lib/donationbee/witness.vkey>", "url": "http://127.0.0.1:8091"}]'
VPP_OTS_ENABLED=true
VPP_ANCHORS_REPO_PATH=/var/lib/donationbee/anchors
VPP_ANCHORS_PUSH=true
VPP_ANCHORS_PUBLIC_URL=https://github.com/HallowDance/donationbee-anchors
VPP_BANNER="Beta: test mode only, no real money moves. Demo hives use example data, and the demo witness is run by us."
