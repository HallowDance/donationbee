# Nightly database and state backup into /var/backups/donationbee (see ../backup.sh).
# That directory is donationbee:hallowdance, mode 2750, so the admin user can pull copies.
[Unit]
Description=DonationBee: back up the database and state
After=postgresql.service

[Service]
Type=oneshot
User=donationbee
Group=donationbee
UMask=0027
ExecStart=/usr/local/lib/donationbee/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/donationbee
