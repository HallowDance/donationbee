# Sends the latest checkpoint to each configured witness and stores their cosignatures.
[Unit]
Description=DonationBee: ask witnesses to cosign the latest checkpoint
After=donationbee-witness.service postgresql.service

[Service]
Type=oneshot
User=donationbee
Group=donationbee
EnvironmentFile=/etc/donationbee/env
ExecStart=/opt/donationbee/.venv/bin/vpp witness-push
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/donationbee
